############################################
# SkillPath AI — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
############################################

# Public site URL (used for share links and reports)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

############################################
# Supabase (optional in demo mode)
# When these are absent the app runs on the
# built-in local demo driver (seed data + in-memory writes).
############################################
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (browser-safe) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — SERVER ONLY. Used by ingestion and admin jobs. Never expose to the browser.
SUPABASE_SECRET_KEY=

############################################
# Google Gemini (optional in demo mode)
# When absent, the AI counsellor falls back to
# deterministic retrieval-only answers over the
# same knowledge base, with the same source list.
############################################
GEMINI_API_KEY=
# Verified against the live model list at setup time (see scripts/verify-models.mjs).
# Mid-2026 Gemini model IDs move fast, so these are configuration, not constants.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the pgvector column in supabase/migrations. Changing it requires re-embedding.
EMBEDDING_DIM=1536
GEMINI_TIMEOUT_MS=8000

############################################
# RAG + AI guardrails
############################################
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.62
RAG_MIN_CHUNKS=1
AI_DAILY_QUOTA=60
AI_CHAT_MAX_OUTPUT_TOKENS=1200
